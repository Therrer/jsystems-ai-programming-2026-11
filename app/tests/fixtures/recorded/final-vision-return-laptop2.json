                            "no",
                            "partly"
                          ],
                          "description": "Whether your own judgement agrees with Luna's answer."
                        },
                        "notePl": {
                          "type": "string",
                          "description": "Short reason in Polish, at most 160 characters."
                        }
                      },
                      "required": [
                        "key",
                        "agrees",
                        "notePl"
                      ],
                      "additionalProperties": false
                    },
                    "description": "One entry for every Luna signal that has a value."
