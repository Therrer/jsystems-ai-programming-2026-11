            "type": "json_schema",
            "json_schema": {
              "schema": {
                "$schema": "http://json-schema.org/draft-07/schema#",
                "type": "object",
                "properties": {
                  "imageUsable": {
                    "type": "boolean",
                    "description": "The photo is sharp, well lit and complete enough to judge the device's condition."
                  },
                  "unusableReason": {
                    "anyOf": [
                      {
                        "type": "string",
                        "enum": [
                          "blurry",
                          "too_dark",
                          "device_not_visible",
                          "partial_view",
                          "other"
                        ]
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "description": "Why the photo is unusable, or null when it is usable."
                  },
                  "deviceVisible": {
                    "type": "boolean",
                    "description": "An electronic device is clearly the main subject of the photo."
                  },
                  "detectedCategory": {
                    "type": "string",
                    "enum": [
                      "smartphone",
                      "laptop",
                      "tablet",
                      "tv",
                      "audio",
                      "wearable",
                      "camera",
                      "small_appliance",
                      "other_device",
                      "no_device"
                    ],
                    "description": "The device category you see in the photo."
                  },
                  "categoryMatch": {
                    "type": "string",
                    "enum": [
                      "match",
                      "mismatch",
                      "unsure"
                    ],
                    "description": "Whether the visible device matches the category the customer selected."
                  },
                  "damageVisible": {
                    "type": "boolean",
                    "description": "Any physical damage or defect is visible."
                  },
                  "damage": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "type": {
                          "type": "string",
                          "enum": [
                            "none",
                            "cracked_glass",
                            "display_defect",
                            "dent_or_deformation",
                            "liquid_damage",
                            "burn_or_melt",
                            "scratches_or_wear",
                            "broken_port_or_button",
                            "other"
                          ],
                          "description": "Damage type."
                        },
                        "location": {
                          "type": "string",
                          "description": "Where on the device, in Polish, at most 80 characters."
                        },
                        "severity": {
                          "type": "string",
                          "enum": [
                            "minor",
                            "moderate",
                            "severe"
                          ],
                          "description": "How serious the damage looks."
                        }
                      },
                      "required": [
                        "type",
                        "location",
                        "severity"
                      ],
                      "additionalProperties": false
                    },
                    "description": "Visible damage items, at most 5; empty when none."
                  },
                  "likelyCause": {
                    "anyOf": [
                      {
                        "type": "string",
                        "enum": [
                          "manufacturing_defect",
                          "impact",
                          "liquid",
                          "heat",
                          "normal_wear",
                          "unclear"
                        ]
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "description": "Complaint cases: most likely cause. Return cases: null."
                  },
                  "signsOfUse": {
                    "anyOf": [
                      {
                        "type": "string",
                        "enum": [
                          "none",
                          "light",
                          "clear",
                          "heavy"
                        ]
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "description": "Return cases: visible signs of use. Complaint cases: null."
                  },
                  "resellableAsNew": {
                    "description": "Return cases: could be resold as new. Complaint cases: null.",
                    "type": [
                      "boolean",
                      "null"
                    ]
                  },
                  "observationsPl": {
                    "type": "string",
                    "description": "Factual observations in Polish, at most 600 characters. No decision."
                  },
