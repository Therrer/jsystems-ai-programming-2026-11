# Copy to app/.env.local and fill in the key. Never commit .env.local.
# Variables per ADR-000 §7.

# Required
OPENROUTER_API_KEY=
LLM_MODEL=openai/gpt-6-luna

# Optional per-role overrides (default: LLM_MODEL)
VISION_MODEL=
DECISION_MODEL=
CHAT_MODEL=

# Luna Decisions pre-check (OpenRouter Decisions API, alpha)
DECISIONS_MODEL=openai/gpt-6-luna-decisions
DECISIONS_ENABLED=true
DECISIONS_CONFIDENCE_THRESHOLD=0.80

# Optional
POLICIES_DIR=
CASE_TTL_MINUTES=120
EVAL_LOG_PATH=
