{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "edit": {
      "*": "allow",
      "**/.env*": "deny"
    },
    "bash": {
      "*": "deny",
      "npx vitest *": "allow",
      "npm test*": "allow",
      "npx tsc --noEmit*": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "ls *": "allow",
      "cat *": "allow",
      "node scripts/make-image-fixtures.mjs*": "allow",
      "npx vitest --help*": "allow",
      "npx playwright --help*": "allow",
      "npx tsc --help*": "allow",
      "npx next --help*": "allow",
      "npm view *": "allow",
      "npx --yes ctx7@latest library *": "allow",
      "npx --yes ctx7@latest docs *": "allow"
    },
    "webfetch": "deny",
    "websearch": "deny",
    "external_directory": "deny"
  }
}
